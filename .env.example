NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Setup:
# 1. Create a Supabase project
# 2. Run supabase/migrations/001_init.sql in the SQL editor
# 3. Create the first Auth user (Authentication > Users). That user becomes superadmin.
# 4. Copy this file to .env.local and fill in the keys
# Draft posts/events stay private via RLS + public queries filtering status=published.
# Publishing sets status=published; public pages are force-dynamic so they appear immediately.
